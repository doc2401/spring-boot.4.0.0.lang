      "count": 3
    },
    {
      "source": "Extract the raw content based on the specified <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.x/javadoc-api/org/springframework/core/env/PropertySource.html\" title=\"class or interface in org.springframework.core.env\"><code>PropertySource</code></a>.",
      "translation": "从指定的 <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.x/javadoc-api/org/springframework/core/env/PropertySource.html\" title=\"class or interface in org.springframework.core.env\"><code>PropertySource</code></a> 中提取原始内容。",
      "count": 3
    },
    {
      "source": "Replace the <code>value</code> for the specified key if the value is not <code>null</code>.",
      "translation": "如果该值不为<code>null</code>，则替换指定键的<code>value</code>。",
      "count": 3
    },
    {
      "source": "Extract the content to contribute to the info endpoint.",
      "translation": "提取要贡献到 info 端点的内容。",
      "count": 3
    },
    {
      "source": "Return the mode that should be used to expose the content.",
      "translation": "返回用于公开内容的模式。",
      "count": 3
    },
    {
      "source": "Return the nested map with the specified key or empty map if the specified map\ncontains no mapping for the key.",
