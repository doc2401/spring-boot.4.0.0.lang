      "translation": "<span class=\"description-from-type-label\">描述从接口复制：<code><a href=\"../../error/ErrorPageRegistry.html#addErrorPages(org.springframework.boot.web.error.ErrorPage...)\">ErrorPageRegistry</a></code></span>",
      "count": 2
    },
