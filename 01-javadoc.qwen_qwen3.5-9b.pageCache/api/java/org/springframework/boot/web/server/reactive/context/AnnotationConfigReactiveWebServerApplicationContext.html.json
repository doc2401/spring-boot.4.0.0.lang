      "count": 2
    },
    {
      "source": "<code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.x/javadoc-api/org/springframework/context/support/AbstractApplicationContext.html#postProcessBeanFactory(org.springframework.beans.factory.config.ConfigurableListableBeanFactory)\" title=\"class or interface in org.springframework.context.support\">postProcessBeanFactory</a></code> in class <code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.x/javadoc-api/org/springframework/context/support/AbstractApplicationContext.html\" title=\"class or interface in org.springframework.context.support\">AbstractApplicationContext</a></code>",
      "translation": "<code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.x/javadoc-api/org/springframework/context/support/AbstractApplicationContext.html#postProcessBeanFactory(org.springframework.beans.factory.config.ConfigurableListableBeanFactory)\" title=\"class or interface in org.springframework.context.support\">postProcessBeanFactory</a></code> 类中的 <code><a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.x/javadoc-api/org/springframework/context/support/AbstractApplicationContext.html\" title=\"class or interface in org.springframework.context.support\">AbstractApplicationContext</a></code>",
      "count": 2
