      "source": "Customize the <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.x/javadoc-api/org/springframework/core/convert/support/ConfigurableConversionService.html\" title=\"class or interface in org.springframework.core.convert.support\"><code>ConfigurableConversionService</code></a>.",
