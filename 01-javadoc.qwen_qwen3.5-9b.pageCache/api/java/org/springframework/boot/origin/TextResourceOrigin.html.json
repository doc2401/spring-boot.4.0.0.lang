      "count": 1
    },
    {
      "source": "A location (line and column number) within the resource.",
      "translation": "资源内的位置（行号和列号）。",
      "count": 1
    },
    {
      "source": "Return the parent origin for this instance if there is one.",
      "translation": "如果存在父级，则返回此实例的父级源。",
      "count": 1
