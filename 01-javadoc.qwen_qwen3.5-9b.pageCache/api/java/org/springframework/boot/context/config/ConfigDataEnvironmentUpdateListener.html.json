      "count": 2
    },
    {
      "source": "<code>propertySource</code> - the <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.x/javadoc-api/org/springframework/core/env/PropertySource.html\" title=\"class or interface in org.springframework.core.env\"><code>PropertySource</code></a> that was added",
