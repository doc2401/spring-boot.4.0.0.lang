    {
      "source": "Bind the specified target <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html\" title=\"class or interface in java.lang\"><code>Class</code></a> using this binder's\n<a href=\"../source/ConfigurationPropertySource.html\" title=\"interface in org.springframework.boot.context.properties.source\"><code>property sources</code></a>.",
      "translation": "使用此绑定器的 <a href=\"../source/ConfigurationPropertySource.html\" title=\"interface in org.springframework.boot.context.properties.source\"><code>property sources</code></a> 来绑定指定的目标 <a class=\"external-link\" href=\"https://docs.oracle.com/en/java/javase/17/docs/api/java.base/java/lang/Class.html\" title=\"class or interface in java.lang\"><code>Class</code></a>。",
      "count": 3
    },
    {
      "source": "Create a new <a href=\"Binder.html\" title=\"class in org.springframework.boot.context.properties.bind\"><code>Binder</code></a> instance for the specified sources. A\n<a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.x/javadoc-api/org/springframework/format/support/DefaultFormattingConversionService.html\" title=\"class or interface in org.springframework.format.support\"><code>DefaultFormattingConversionService</code></a> will be used for all conversion.",
      "translation": "为指定的源创建一个新的<a href=\"Binder.html\" title=\"class in org.springframework.boot.context.properties.bind\"><code>Binder</code></a>实例。将使用一个<a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.x/javadoc-api/org/springframework/format/support/DefaultFormattingConversionService.html\" title=\"class or interface in org.springframework.format.support\"><code>DefaultFormattingConversionService</code></a>进行所有转换。",
      "count": 3
    },
    {
      "source": "<code>environment</code> - the environment source (must have attached\n<a href=\"../source/ConfigurationPropertySources.html\" title=\"class in org.springframework.boot.context.properties.source\"><code>ConfigurationPropertySources</code></a>)",
