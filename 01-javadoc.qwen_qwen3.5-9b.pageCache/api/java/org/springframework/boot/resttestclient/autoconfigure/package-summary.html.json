    {
      "source": "Test support classes that use <a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.x/javadoc-api/org/springframework/web/client/RestClient.html\" title=\"class or interface in org.springframework.web.client\"><code>RestClient</code></a> and\n<a class=\"external-link\" href=\"https://docs.spring.io/spring-framework/docs/7.0.x/javadoc-api/org/springframework/web/client/RestTemplate.html\" title=\"class or interface in org.springframework.web.client\"><code>RestTemplate</code></a>.",
